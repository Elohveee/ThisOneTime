{
  "manifest_version": 3,
  "name": "ThisOneTime S3 Spike",
  "description": "Runs a 50-album download queue with pause, tab close, and resume. Produces a report with no personal data.",
  "version": "0.0.1",
  "minimum_chrome_version": "122",
  "action": {
    "default_title": "Open the ThisOneTime S3 spike"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://bandcamp.com/*",
    "https://*.bandcamp.com/*",
    "https://*.bcbits.com/*"
  ]
}
