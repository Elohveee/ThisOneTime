{
  "manifest_version": 3,
  "name": "ThisOneTime S1 Spike",
  "description": "Read-only test of the Bandcamp library flow. Produces a report with no personal data.",
  "version": "0.0.1",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open the ThisOneTime S1 spike"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://bandcamp.com/*",
    "https://*.bandcamp.com/*",
    "https://*.bcbits.com/*"
  ]
}
