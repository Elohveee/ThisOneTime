{
  "manifest_version": 3,
  "name": "ThisOneTime",
  "description": "Back up your purchased Bandcamp library in your preferred format, unzipped and ready to play.",
  "version": "1.0.0",
  "minimum_chrome_version": "122",
  "action": {
    "default_title": "Open ThisOneTime"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://bandcamp.com/*",
    "https://*.bandcamp.com/*",
    "https://*.bcbits.com/*"
  ]
}
