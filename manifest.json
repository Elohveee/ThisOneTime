{
  "manifest_version": 3,
  "name": "ThisOneTime",
  "description": "Back up your purchased Bandcamp library in your preferred format, unzipped and ready to play.",
  "version": "1.0.0",
  "minimum_chrome_version": "122",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open ThisOneTime",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://bandcamp.com/*",
    "https://*.bandcamp.com/*",
    "https://*.bcbits.com/*"
  ]
}
